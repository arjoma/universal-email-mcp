# Local testing: copy to .env (gitignored) and run with
#   uv run --env-file .env universal-email-mcp <probe|local> ...
# See "Local testing with a real mailbox" in AGENTS.md.

# Config file for local mode; config.local.toml is gitignored (*.local.toml).
UEM_CONFIG=config.local.toml

# Passwords: prefer the OS keyring (uv run keyring set universal-email-mcp <account>).
# Coding agents working in this repository can read .env.
# UEM_WORK_PASSWORD=
